diff -ruN a/include/wasm32-wasip1/signal.h b/include/wasm32-wasip1/signal.h
--- a/include/wasm32-wasip1/signal.h
+++ b/include/wasm32-wasip1/signal.h
@@ -321,6 +321,47 @@
 void (*signal(int, void (*)(int)))(int);
 int raise(int);
 
+#include <errno.h>
+
+#define __NEED_sigset_t
+#include <bits/alltypes.h>
+
+struct sigaction {
+	void (*sa_handler)(int);
+	sigset_t sa_mask;
+	int sa_flags;
+};
+
+#define SA_NOCLDSTOP 1
+#define SA_RESTART 0x10000000
+#define SIG_BLOCK 0
+#define SIG_UNBLOCK 1
+#define SIG_SETMASK 2
+
+#define __SIGBIT(n) (1UL << (((n) - 1) % (8 * sizeof(long))))
+#define __SIGWORD(s, n) ((s)->__bits[((n) - 1) / (8 * sizeof(long))])
+
+static inline int sigemptyset(sigset_t *s) { __builtin_memset(s, 0, sizeof *s); return 0; }
+static inline int sigfillset(sigset_t *s) { __builtin_memset(s, 0xff, sizeof *s); return 0; }
+static inline int sigaddset(sigset_t *s, int n) { __SIGWORD(s, n) |= __SIGBIT(n); return 0; }
+static inline int sigdelset(sigset_t *s, int n) { __SIGWORD(s, n) &= ~__SIGBIT(n); return 0; }
+static inline int sigismember(const sigset_t *s, int n) { return (__SIGWORD(s, n) & __SIGBIT(n)) != 0; }
+static inline int sigprocmask(int how, const sigset_t *set, sigset_t *old) { if (old) sigemptyset(old); return 0; }
+
+static inline int sigaction(int sig, const struct sigaction *act, struct sigaction *old) {
+	void (*prev)(int) = signal(sig, act ? act->sa_handler : SIG_DFL);
+	if (prev == SIG_ERR) {
+		errno = EINVAL;
+		return -1;
+	}
+	if (!act) signal(sig, prev);
+	if (old) {
+		__builtin_memset(old, 0, sizeof *old);
+		old->sa_handler = prev;
+	}
+	return 0;
+}
+
 #ifdef __wasilibc_unmodified_upstream /* WASI has no sigtimedwait */
 #if _REDIR_TIME64
 #if defined(_POSIX_SOURCE) || defined(_POSIX_C_SOURCE) \
