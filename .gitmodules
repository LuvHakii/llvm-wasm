[submodule "llvm-project"]
	path = llvm-project
	url = https://github.com/llvm/llvm-project.git
	shallow = true
[submodule "emsdk"]
	path = emsdk
	url = https://github.com/emscripten-core/emsdk.git
	shallow = true
[submodule "gcc"]
	path = gcc
	url = https://github.com/gcc-mirror/gcc.git
	shallow = true
	update = none
[submodule "wasi-libc-patches"]
	path = wasi-libc-patches
	url = https://github.com/LuvHakii/wasi-libc-patches
